      { "name": "x.search_users", "permission": "x_search_users", "effect": "allow", "readOnly": true },
      { "name": "x.article_create_draft", "permission": "x_article_create_draft", "effect": "ask", "readOnly": false },
      { "name": "x.create_users_bookmark", "permission": "x_create_users_bookmark", "effect": "ask", "readOnly": false },
      { "name": "x.create_users_bookmark_folder", "permission": "x_create_users_bookmark_folder", "effect": "ask", "readOnly": false },
      { "name": "x.delete_users_bookmark", "permission": "x_delete_users_bookmark", "effect": "ask", "readOnly": false },
      { "name": "x.article_publish", "permission": "x_article_publish", "effect": "ask", "readOnly": false }

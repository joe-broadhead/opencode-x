    "skills": [
      "x",
      "x-write"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "x",
        "label": "X",
        "server": "x"
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": []
    }
